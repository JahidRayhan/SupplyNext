# Copy this to .env and fill in real values. Never commit .env itself.

# --- Database ---
# Either set DATABASE_URL, or the discrete PG* vars below (DATABASE_URL wins if both are set).
# DATABASE_URL=postgres://user:password@host:5432/sdcip?sslmode=require
PGHOST=localhost
PGPORT=5432
PGDATABASE=sdcip
PGUSER=sdcip
PGPASSWORD=change_me
# SSL is auto-enabled when DATABASE_URL is set (hosted providers like Neon/
# Supabase require it). Force it explicitly with PGSSL=true or PGSSL=false
# if needed (e.g. a self-hosted Postgres with DATABASE_URL but no TLS).
# PGSSL=true

# --- Auth ---
# Generate a real secret for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS ---
# The exact origin of the deployed frontend, e.g. https://sdcip.vercel.app
# Leave unset in local dev to allow all origins.
# CORS_ORIGIN=https://your-frontend-domain.example
